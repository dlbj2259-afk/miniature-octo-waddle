# ---- Required ----
# Random 32+ char secret: signs sessions and encrypts API keys stored from the UI.
# Generate with: openssl rand -hex 32   (never change it after storing keys in the UI)
APP_SECRET=
# Owner login (created on first boot if no user exists). Use a strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- AI agent (required) ----
# https://console.anthropic.com -> API Keys. Enable "Web search" for your org in the Console.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_EFFORT=high            # low | medium | high | xhigh | max
# ANTHROPIC_WEB_SEARCH=true
# ANTHROPIC_FALLBACKS=true     # server-side refusal fallbacks (auto-disabled if unsupported)

# ---- Business search (required) ----
# Google Cloud Console -> enable "Places API (New)" -> Credentials -> API key (restrict to Places API)
GOOGLE_PLACES_API_KEY=

# ---- Public procurement (optional) ----
# https://sam.gov -> Account Details -> Public API Key
SAM_GOV_API_KEY=

# ---- Email for daily report + owner-approved outreach (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WoogzMadeit <you@yourdomain.com>"
REPORT_EMAIL_TO=

# ---- Server ----
PORT=3000
DATA_DIR=./data
NODE_ENV=production
COOKIE_SECURE=true            # set false only for plain-http local testing
TRUST_PROXY=true              # true behind Render/Railway/Fly/NGINX
ENABLE_SCHEDULER=true
APP_TIMEZONE=America/Detroit
# HOME_BASE_NAME="Pontiac, MI"
# HOME_BASE_LAT=42.6389
# HOME_BASE_LNG=-83.2910
