{
  "name": "woogzmadeit-client-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI client-finder agent for WoogzMadeit (Pontiac, MI)",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "job": "node --disable-warning=ExperimentalWarning src/jobs/cli.js",
    "set-password": "node --disable-warning=ExperimentalWarning src/jobs/cli.js set-password",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16"
  }
}
